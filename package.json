{
  "name": "neetcode-visualizer",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p .",
    "check": "python3 scripts/check_problems.py",
    "validate": "node scripts/validate-content.mjs",
    "predev": "node scripts/copy-pyodide.mjs",
    "prebuild": "node scripts/copy-pyodide.mjs",
    "postinstall": "node scripts/copy-pyodide.mjs"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "framer-motion": "^14.7.1",
    "monaco-editor": "^0.57.0",
    "pyodide": "^314.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.1.9",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
